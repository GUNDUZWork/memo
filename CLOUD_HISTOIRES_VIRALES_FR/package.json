{
  "name": "cloud-histoires-virales-fr",
  "version": "1.0.0",
  "private": true,
  "description": "Usine de rendu cloud : 30 épisodes FR (film 16:9 + Short 9:16) via node-canvas, edge-tts et ffmpeg",
  "main": "cloudViralEngine.js",
  "scripts": {
    "validate": "node validateEpisodes.js",
    "render": "node cloudViralEngine.js all --episode",
    "test:mock": "node cloudViralEngine.js all --episode 1 --mock --preview 20"
  },
  "engines": { "node": ">=20" },
  "dependencies": {
    "canvas": "3.1.0"
  }
}
